# Copia este archivo como .env.local y rellena los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Si lo dejas vacío, la app arranca en MODO DEMO
# con datos de prueba guardados en el navegador.
VITE_SUPABASE_URL=
# Sirve la "anon key" o la nueva "publishable key" (sb_publishable_...). Es pública:
# la seguridad la ponen las políticas RLS de supabase/schema.sql.
VITE_SUPABASE_ANON_KEY=
